# Dummy values for CI build, unit tests and the Playwright smoke. Not secrets (gitleaks-allowlisted).
# Loaded by scripts/with-env.sh; variables already set in the environment win.
DATABASE_URL=postgres://steward:steward@localhost:5432/steward
LOG_LEVEL=warn
TRUSTED_PROXY_HOPS=1
DEMO_PASSCODE=ci-demo-passcode
SESSION_SECRET=ci-only-session-secret-0123456789abcdef-not-a-secret
PAYPAL_ENV=sandbox
AI_PROVIDER=mock
DISPUTE_SOURCE=simulated
POLICIES_ENABLED=false
