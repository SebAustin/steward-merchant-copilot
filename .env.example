# Copy to .env and edit. Placeholders only: never commit real values.
# Empty values count as "not set", so a credential-free setup still boots.

# --- Runtime ---
# Local Postgres from `pnpm db:up` (docker compose, host port 54329).
DATABASE_URL=postgres://steward:steward@localhost:54329/steward
LOG_LEVEL=info
# Reverse-proxy hops in front of the app (Render: 1). Used to pick the client IP for rate limits.
TRUSTED_PROXY_HOPS=1

# --- Demo access ---
# Shared passcode printed in the README (D-4). Min 8 characters.
DEMO_PASSCODE=change-me-demo-passcode
# Signs the session cookie. Min 32 characters. Generate: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
# Authenticates GitHub Actions calls to the cron routes (from slice 0.2b).
CRON_SECRET=

# --- PayPal sandbox app (needed from slice 0.1c) ---
# The sandbox is the only supported environment (NG1).
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after registering the webhook for the deployed URL (slice 0.5a).
PAYPAL_WEBHOOK_ID=

# --- Model ---
# mock = scripted model, no network. Render must use anthropic (mock is rejected there).
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# --- Spend ledger for off-server writers (evals, dev): role steward_eval, see scripts/sql/steward_eval_grants.sql ---
EVAL_DATABASE_URL=

# --- Product switches ---
# live | simulated | mixed (read-only in Settings)
DISPUTE_SOURCE=simulated
POLICIES_ENABLED=false

# --- Spend caps in USD (D-11); enforced from slice 0.1e ---
DEMO_DAILY_CAP_USD=5
DEMO_TOTAL_CAP_USD=50
EVAL_CAP_USD=70
DEV_CAP_USD=30
SESSION_TOKEN_CAP=100000

# --- Public (domain-locked) AG Grid license key. The only secret-looking NEXT_PUBLIC_ name allowed. ---
NEXT_PUBLIC_AG_GRID_LICENSE_KEY=
